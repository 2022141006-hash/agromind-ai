# AgroMind AI - Backend Environment Variables

# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database - MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=agromind_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=agromind_jwt_secret_change_in_production_2024
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=agromind_refresh_secret_change_in_production_2024
JWT_REFRESH_EXPIRES_IN=7d

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=30000

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logs
LOG_LEVEL=debug
LOG_DIR=logs

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
