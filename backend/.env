PORT=4000
NODE_ENV=development
API_VERSION=v1

# MariaDB Config (Laragon defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agromind_db

# Security & JWT
JWT_SECRET=agromind_secret_key_2026_super_secure_enterprise_jwt
JWT_EXPIRES_IN=7d

# Microservicio ML (FastAPI Python)
ML_SERVICE_URL=http://localhost:8000

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
